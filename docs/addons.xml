<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.tv-italiana" name="Nonno Stream" version="1.0.2" provider-name="Nonno Stream">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="it">Apri le dirette Rai in Kodi</summary>
        <description lang="it">Mostra un collegamento ai canali in diretta dell'add-on Rai Play per Kodi. Rai Play deve essere installato separatamente.</description>
        <platform>all</platform>
        <assets>
            <icon>resources/icon.png</icon>
        </assets>
    </extension>
</addon>

<addon id="repository.nonnostream" name="Nonno Stream Repository" version="1.0.1" provider-name="NonnoStream">
    <requires>
        <import addon="xbmc.addon" version="12.0.0"/>
    </requires>
    <extension point="xbmc.addon.repository" name="Nonno Stream Repository">
        <dir>
            <info compressed="false">https://cdn.jsdelivr.net/gh/NonnoStream/plugin.video.tv-italiana@main/docs/addons.xml</info>
            <checksum>https://cdn.jsdelivr.net/gh/NonnoStream/plugin.video.tv-italiana@main/docs/addons.xml.md5</checksum>
            <datadir zip="true">https://cdn.jsdelivr.net/gh/NonnoStream/plugin.video.tv-italiana@main/docs/zips/</datadir>
            <hashes>false</hashes>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="it">Repository ufficiale di Nonno Stream</summary>
        <description lang="it">Installa e aggiorna Nonno Stream da Kodi.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>

</addons>
